{
  "integration": {
    "enterprise_data_pipeline": "../enterprise-data-pipeline",
    "data_processing_enrichment": "../data-processing-enrichment",
    "embedding_retrieval_intelligence": "../embedding-retrieval-intelligence",
    "orchestration_guardrails": "../orchestration-guardrails",
    "experience_api_engagement": "../experience-api-engagement",
    "security_governance": "../security-governance"
  },
  "storage": {
    "metrics_uri": "data/metrics/metrics.jsonl",
    "logs_uri": "data/logs/logs.jsonl",
    "traces_uri": "data/traces/spans.jsonl",
    "ai_interactions_uri": "data/ai/interactions.jsonl",
    "alerts_uri": "data/alerts/alerts.jsonl"
  },
  "services": {
    "enterprise-data-pipeline": {
      "layer": "ingestion",
      "owner": "data-platform",
      "slo_latency_ms": 5000,
      "slo_error_rate": 0.02
    },
    "data-processing-enrichment": {
      "layer": "processing",
      "owner": "data-platform",
      "slo_latency_ms": 10000,
      "slo_error_rate": 0.02
    },
    "embedding-retrieval-intelligence": {
      "layer": "retrieval",
      "owner": "ai-platform",
      "slo_latency_ms": 1500,
      "slo_error_rate": 0.01
    },
    "orchestration-guardrails": {
      "layer": "guardrails",
      "owner": "ai-platform",
      "slo_latency_ms": 2500,
      "slo_error_rate": 0.01
    },
    "experience-api-engagement": {
      "layer": "engagement",
      "owner": "app-platform",
      "slo_latency_ms": 1000,
      "slo_error_rate": 0.01
    },
    "security-governance": {
      "layer": "security",
      "owner": "security",
      "slo_latency_ms": 1000,
      "slo_error_rate": 0.005
    },
    "observability-monitoring": {
      "layer": "observability",
      "owner": "platform",
      "slo_latency_ms": 1000,
      "slo_error_rate": 0.005
    }
  },
  "alerts": {
    "latency_ms_threshold": 2000,
    "error_rate_threshold": 0.05,
    "min_ai_confidence": 0.3,
    "denied_access_threshold": 5
  },
  "exporters": {
    "otel": {
      "enabled": true,
      "type": "opentelemetry",
      "endpoint": "http://localhost:4318"
    },
    "prometheus": {
      "enabled": true,
      "type": "prometheus",
      "endpoint": "http://localhost:9090"
    },
    "grafana": {
      "enabled": true,
      "type": "grafana",
      "endpoint": "http://localhost:3000"
    },
    "datadog": {
      "enabled": false,
      "type": "datadog",
      "endpoint": "https://api.datadoghq.com",
      "api_key_env": "DATADOG_API_KEY"
    },
    "splunk": {
      "enabled": false,
      "type": "splunk",
      "endpoint": "https://splunk.example.com:8088",
      "api_key_env": "SPLUNK_HEC_TOKEN"
    },
    "cloudwatch": {
      "enabled": false,
      "type": "cloudwatch",
      "endpoint": "https://monitoring.us-east-1.amazonaws.com"
    }
  }
}

{"chunk_id": "doc-001:0", "chunk_index": 0, "document_id": "doc-001", "metadata": {"classification": "security", "dates": [], "document_title": "Security Access Policy", "emails": ["security@veloxsdemo.com"], "entities": ["Access", "Contact", "Encryption", "Security Access Policy All"], "money": [], "source_primary_key": "doc-001", "tags": ["security"]}, "processed_at": "2026-07-05T22:21:30.729383Z", "source_job": "policy_documents", "text": "All employees must use MFA for sensitive systems. Access reviews are required quarterly. Encryption is mandatory for confidential exports. Contact security@veloxsdemo.com for exceptions."}
{"chunk_id": "doc-002:0", "chunk_index": 0, "document_id": "doc-002", "metadata": {"classification": "security", "dates": [], "document_title": "Data Encryption Standard", "emails": [], "entities": ["Data Encryption Standard Confidential", "Keys"], "money": [], "source_primary_key": "doc-002", "tags": ["security"]}, "processed_at": "2026-07-05T22:21:30.729407Z", "source_job": "policy_documents", "text": "Confidential data must be encrypted at rest and in transit using approved algorithms. TLS 1.2 or higher is required for all access to internal systems. Keys are rotated annually."}
{"chunk_id": "doc-003:0", "chunk_index": 0, "document_id": "doc-003", "metadata": {"classification": "security", "dates": [], "document_title": "Account Access Review Procedure", "emails": [], "entities": ["Account Access Review Procedure Access", "Privileged", "Quarterly"], "money": [], "source_primary_key": "doc-003", "tags": ["customer", "security"]}, "processed_at": "2026-07-05T22:21:30.729427Z", "source_job": "policy_documents", "text": "Access to customer accounts follows least privilege. Quarterly access reviews remove stale permissions. Privileged access requires manager approval and is logged for audit."}
{"chunk_id": "doc-004:0", "chunk_index": 0, "document_id": "doc-004", "metadata": {"classification": "finance", "dates": [], "document_title": "Invoice Handling Procedure", "emails": ["ap@veloxsdemo.com"], "entities": ["Invoice Handling Procedure Invoices", "Revenue", "Send"], "money": [], "source_primary_key": "doc-004", "tags": ["finance"]}, "processed_at": "2026-07-05T22:21:30.729444Z", "source_job": "policy_documents", "text": "Invoices must be reviewed before payment. Revenue-impacting adjustments require finance approval. Send invoice questions to ap@veloxsdemo.com by the monthly close date."}
{"chunk_id": "doc-005:0", "chunk_index": 0, "document_id": "doc-005", "metadata": {"classification": "finance", "dates": [], "document_title": "Payment and Refund Policy", "emails": [], "entities": ["Disputed", "Payment", "Refund Policy Customer", "Refunds"], "money": [], "source_primary_key": "doc-005", "tags": ["finance"]}, "processed_at": "2026-07-05T22:21:30.729462Z", "source_job": "policy_documents", "text": "Customer payments are reconciled weekly. Refunds above the threshold require finance approval. Disputed invoices are escalated to the revenue team within two business days."}
{"chunk_id": "doc-006:0", "chunk_index": 0, "document_id": "doc-006", "metadata": {"classification": "customer", "dates": [], "document_title": "Customer Support SLA", "emails": [], "entities": ["Critical", "Customer Support", "Renewal", "Support"], "money": [], "source_primary_key": "doc-006", "tags": ["customer"]}, "processed_at": "2026-07-05T22:21:30.729479Z", "source_job": "policy_documents", "text": "Support requests receive a first response within four business hours. Renewal and account questions are routed to customer success. Critical issues are escalated to on-call support."}

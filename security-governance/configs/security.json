{
  "integration": {
    "experience_project": "../experience-api-engagement",
    "guardrails_project": "../orchestration-guardrails",
    "retrieval_project": "../embedding-retrieval-intelligence",
    "processing_project": "../data-processing-enrichment",
    "ingestion_project": "../enterprise-data-pipeline"
  },
  "tenants": {
    "tenant-a": {
      "name": "Tenant A",
      "data_scopes": [
        "customer",
        "policy",
        "finance"
      ]
    },
    "tenant-b": {
      "name": "Tenant B",
      "data_scopes": [
        "customer",
        "policy"
      ]
    }
  },
  "roles": {
    "analyst": {
      "permissions": [
        "read:data",
        "query:ai",
        "read:audit:self"
      ],
      "data_scopes": [
        "customer",
        "policy"
      ]
    },
    "admin": {
      "permissions": [
        "read:data",
        "write:data",
        "query:ai",
        "read:audit",
        "manage:policy",
        "cross_tenant:read"
      ],
      "data_scopes": [
        "*"
      ]
    },
    "service_account": {
      "permissions": [
        "read:data",
        "write:audit",
        "emit:telemetry",
        "query:ai"
      ],
      "data_scopes": [
        "*"
      ]
    }
  },
  "encryption": {
    "enabled": true,
    "key_id": "local-dev-key",
    "key_material_env": "NEXUS_SECURITY_KEY",
    "require_tls": true,
    "allowed_tls_versions": [
      "TLSv1.2",
      "TLSv1.3"
    ]
  },
  "audit": {
    "enabled": true,
    "output_uri": "data/audit/audit.jsonl",
    "include_denied_events": true
  },
  "observability": {
    "enabled": true,
    "output_uri": "data/telemetry/events.jsonl",
    "service_name": "nexus-security-governance"
  }
}
